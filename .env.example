# Base URL of the Express backend API, including its version prefix.
# The frontend is a static SPA with no server runtime, so this value is
# baked in at build time and every request is made directly from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# VAPID public key used to create a Web Push subscription (PushManager.subscribe).
# Must match the backend's configured VAPID key pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

NEXT_PUBLIC_APP_NAME="My Day Tracker"
